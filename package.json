{
  "name": "open-neuroanatomy-atlas",
  "version": "0.1.0",
  "description": "Open Neuroanatomy Atlas: interactive 3D neuroanatomy for teaching (DBS targets, white-matter tracts, skull base). MNI ICBM 2009b. Not for planning.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pipeline": "bash pipeline/run_all.sh",
    "check:palette": "node scripts/run-ts.mjs scripts/check-palette.ts"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "~1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "three": "^0.187.0",
    "zod": "~4.6.7"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
